{
  "expo": {
    "name": "Kampive",
    "slug": "kampive-app",
    "scheme": "kampive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#003c2d"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#003c2d",
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "ios": {
            "image": "./assets/splash.png",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o Kampive acesse as fotos que você deseja compartilhar.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o Kampive encontre a localização do camping que você está cadastrando."
        }
      ],
      "expo-asset",
      "expo-localization"
    ]
  }
}
